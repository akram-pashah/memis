@model IEnumerable<MEMIS.Models.Register>

<h4>User Management</h4>
<hr />
<table class="table">
    <thead>
        <tr>
            <th>Username</th>
            <th>Email</th>
            <th>Department</th>
            <th>Directorate</th>
            <th>Region</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Username</td>
                <td>@user.Email</td> 
                <td>
                    <form asp-action="ChangePassword" asp-controller="User" method="get">
                        <input type="hidden" name="userId" value="@user.IntUser" />
                        <button type="submit" class="btn btn-warning">Change Password</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
