@model MEMIS.Data.Outcome

@{
  ViewData["Title"] = "Create";
  //Layout = "~/Views/Shared/_PlanningLayout.cshtml";
  Layout = "~/Pages/Shared/_ContentNavbarLayout.cshtml";
}

<h1>Create</h1>

<h4>Outcome</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="OutcomeCode" class="control-label"></label><span class="text-danger">*</span>
                <input asp-for="OutcomeCode" class="form-control" />
                <span asp-validation-for="OutcomeCode" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="OutcomeName" class="control-label"></label><span class="text-danger">*</span>
                <input asp-for="OutcomeName" class="form-control" />
                <span asp-validation-for="OutcomeName" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="intObjective" class="control-label"></label><span class="text-danger">*</span>
                @Html.DropDownList("intObjective", ViewData["intObjective"] as SelectList, "-- Select Objective --", new { @class = "form-control" })
                @* <select asp-for="intObjective" class="form-control form-select" asp-items="ViewBag.intObjective"></select> *@
            </div>
            <br />
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<br />
<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @*@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}*@
}
