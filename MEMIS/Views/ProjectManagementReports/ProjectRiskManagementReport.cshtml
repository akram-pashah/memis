    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@using MEMIS.Data;
@model ProjectInitiation
@{
    ViewData["Title"] = "Project Management Reports";







    //Layout = "~/Views/Shared/_PlanningLayout.cshtml";







    Layout = "~/Pages/Shared/_ContentNavbarLayout.cshtml";















    var ProjectInitiationId = ViewBag.SelectedProjectInitiationId;
}

<h4 class="py-3 mb-4">
    <span class="text-muted fw-light">Project Management Reports /</span> Project Risk Management Report
</h4>

<div class="row">
    <div class="col-md-12">
        <ul class="nav nav-pills flex-column flex-md-row mb-3">
            <li class="nav-item"><a class="nav-link" asp-action="Index">Project List Report</a></li>
            <li class="nav-item"><a class="nav-link" asp-action="ProjectActivitySchedule">Project Activity Schedule Report</a></li>
            <li class="nav-item"><a class="nav-link active" href="javascript:void(0);">Project Risk Management Report</a></li>
            <li class="nav-item"><a class="nav-link" asp-action="StakeholderManagementReport">Stake Holder Management Report</a></li>
            <li class="nav-item"><a class="nav-link" asp-action="IssueLogReport">Issue Log Report</a></li>
        </ul>

        <div class="card mb-4">
            <<form asp-action="ProjectRiskManagementReport" class="card-header row">
                <div class="col d-flex justify-content-start mb-3">
                    <select class="form-control form-control-sm" asp-for="@ProjectInitiationId" name="ProjectInitiationId" asp-items="ViewBag.ProjectInitiations">
                        <option value="">Select Project</option>
                    </select>
                    <input type="submit" class="btn btn-primary float-end float-right" value="Load" />
                </div>
                <div class="col d-flex justify-content-end mb-3">
                    <a class="btn btn-outline-success float-end float-right" asp-action="ProjectRiskManagementReportExcel" asp-route-ProjectInitiationId="@ViewBag.SelectedProjectInitiationId" target="_blank">Export to Excel</a>
                    <a class="btn btn-outline-danger float-end float-right" asp-action="ProjectRiskManagementReportPdf" asp-route-ProjectInitiationId="@ViewBag.SelectedProjectInitiationId" target="_blank">Export to Pdf</a>

                </div>
            </form>

            <hr class="my-0" />

            <div class="card-body">
                <div class="card accordion-item active align-items-center">

                    <button type="button accordion-header mb-3 text-center align-items-center" class="accordion-button text-center" data-bs-toggle="collapse" data-bs-target="#accordionOne" aria-expanded="true" aria-controls="accordionOne">
                        <h4 id="headingOne" class="text-center align-items-center">
                            Project Details
                        </h4>
                    </button>

                    <div id="accordionOne" class="accordion-collapse collapse show" data-bs-parent="#accordionExample">
                        <div class="accordion-body">
                            <div class="row">
                                <div class="mb-3 col-4">
                                    <label for="exampleFormControlReadOnlyInputPlain1" class="form-label">Project Name</label>
                                    <input type="text" readonly class="form-control-plaintext" id="exampleFormControlReadOnlyInputPlain1" value="@Model.Name" />
                                </div>
                                <div class="mb-3 col-4">
                                    <label for="exampleFormControlReadOnlyInputPlain2" class="form-label">Start Date</label>
                                    <input type="text" readonly class="form-control-plaintext" id="exampleFormControlReadOnlyInputPlain2" value="@Model.StartDate.ToShortDateString()" />
                                </div>
                                <div class="mb-3 col-4">
                                    <label for="exampleFormControlReadOnlyInputPlain3" class="form-label">End Date</label>
                                    <input type="text" readonly class="form-control-plaintext" id="exampleFormControlReadOnlyInputPlain3" value="@Model.EndDate.ToShortDateString()" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="mb-3 col-4">
                                    <label for="exampleFormControlReadOnlyInputPlain4" class="form-label">Project Manager</label>
                                    <input type="text" readonly class="form-control-plaintext" id="exampleFormControlReadOnlyInputPlain4" value="@Model.Manager" />
                                </div>
                                <div class="mb-3 col-4">
                                    <label for="exampleFormControlReadOnlyInputPlain5" class="form-label">Budget</label>
                                    <input type="text" readonly class="form-control-plaintext" id="exampleFormControlReadOnlyInputPlain5" value="@Model.Cost" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="my-0" />

                <div style="width:100%; overflow-x:auto;">
                    <table class="table table-striped table-bordered table-hover dt-responsive nowrap">
                        <thead class="table-active">
                            <tr>
                                <th>
                                    Stage
                                </th>
                                <th>
                                    Risk
                                </th>
                                <th>
                                    Likelihood
                                </th>
                                <th>
                                    Severity
                                </th>
                                <th>
                                    Rank
                                </th>
                                <th>
                                    Consequence
                                </th>
                                <th>
                                    Mitigation
                                </th>
                                <th>
                                    Risk Implementation Cost
                                </th>
                                <th>
                                    Ownership
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.ProjectRiskIdentifications)







                            {
                                <tr>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Stage)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Risk)
                                    </td>
                                    <td>
                                        @Enum.GetName(typeof(MEMIS.EnumRiskRank), item.Likelihood)
                                    </td>
                                    <td>
                                        @Enum.GetName(typeof(MEMIS.EnumRiskRank), item.Severity)
                                    </td>
                                    <td>
                                        @* @Enum.GetName(typeof(MEMIS.EnumRiskRank), item.Rank) *@
                                        @item.Rank
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Consequence)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Mitigation)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.RiskImplementationCost)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Ownership)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
