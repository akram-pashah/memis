@model MEMIS.Models.SensitizationMeetingDto

@{
  ViewData["Title"] = "Edit";
  //Layout = "~/Views/Shared/_GISLayout.cshtml";
  Layout = "~/Pages/Shared/_ContentNavbarLayout.cshtml";
}

<h4>Radio Talk Shows </h4>
<hr />
<div class="row">

    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="InspectionDate" class="control-label"></label>
                <input asp-for="InspectionDate" class="form-control" />
                <span asp-validation-for="InspectionDate" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="InspectorName" class="control-label"></label>
                <input asp-for="InspectorName" class="form-control" />
                <span asp-validation-for="InspectorName" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="Latitude" class="control-label"></label>
                <div class="input-group">
                    <input asp-for="Latitude" class="form-control" readonly />
                    <button type="button" id="getCoordinates" class="btn btn-sm btn-primary"><i class="bx bx-map-pin"></i> &nbsp;Location</button>
                </div>
                <span asp-validation-for="Latitude" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="Longitude" class="control-label"></label>
                <div class="input-group">
                    <input asp-for="Longitude" class="form-control" readonly />
                </div>
                <span asp-validation-for="Longitude" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="intRegion" class="control-label"></label>
                <select asp-for="intRegion" class="form-control" asp-items="ViewBag.intRegion"></select>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="DistrictId" class="control-label">District</label>
                <select asp-for="DistrictId" class="form-control" asp-items="ViewBag.DistrictId"></select>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="FacilityName" class="control-label"></label>
                <input asp-for="FacilityName" class="form-control" />
                <span asp-validation-for="FacilityName" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="Topic" class="control-label"></label>
                <input asp-for="Topic" class="form-control" />
                <span asp-validation-for="Topic" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="Participants" class="control-label"></label>
                <input asp-for="Participants" class="form-control" />
                <span asp-validation-for="Participants" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<br />
<div>
	<a asp-action="Index">Back to List</a>
</div>

