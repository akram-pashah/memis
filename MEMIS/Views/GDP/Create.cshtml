@model MEMIS.Models.GDPDto
@{
    ViewData["Title"] = "Create";
    //Layout = "~/Views/Shared/_GISLayout.cshtml";
    Layout = "~/Pages/Shared/_ContentNavbarLayout.cshtml";
}

<h5>GDP</h5>
<hr />
<div></div>
<div class="row">

    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="InspectionDate" class="control-label"></label>
                <input asp-for="InspectionDate" class="form-control" />
                <span asp-validation-for="InspectionDate" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="InspectorName" class="control-label"></label>
                <input asp-for="InspectorName" class="form-control" />
                <span asp-validation-for="InspectorName" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="Latitude" class="control-label"></label>
                <div class="input-group">
                    <input asp-for="Latitude" class="form-control" readonly />
                    <button type="button" id="getCoordinates" class="btn btn-sm btn-primary"><i class="bx bx-map-pin"></i> &nbsp;Location</button>
                </div>
                <span asp-validation-for="Latitude" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="Longitude" class="control-label"></label>
                <div class="input-group">
                    <input asp-for="Longitude" class="form-control" readonly />
                </div>
                <span asp-validation-for="Longitude" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="intRegion" class="control-label"></label>
                <select asp-for="intRegion" class="form-control" asp-items="ViewBag.intRegion"></select>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="DistrictId" class="control-label">District ID</label>
                <select asp-for="DistrictId" class="form-control" asp-items="ViewBag.DistrictId"></select>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="FacilityName" class="control-label">Facility Name</label>
                <input asp-for="FacilityName" class="form-control" />
                <span asp-validation-for="FacilityName" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="FacilityStatus" class="control-label"></label>
                <select asp-for="FacilityStatus" class="form-control" asp-items="ViewBag.FacilityStatus"></select>
                <span asp-validation-for="FacilityStatus" class="text-danger"></span>
            </div>
            <br />
            <div id="open-facilty" class="conditional-fields">
                <div class="form-group">
                    <label asp-for="FacilityPersonType" class="control-label"></label>
                    <select asp-for="FacilityPersonType" class="form-control" asp-items="ViewBag.PersonFoundatFacility"></select>
                    <span asp-validation-for="FacilityPersonType" class="text-danger"></span>
                </div>
                <br />
                <div class="form-group">
                    <label asp-for="PersonName" class="control-label">Person Name</label>
                    <input asp-for="PersonName" class="form-control" />
                    <span asp-validation-for="PersonName" class="text-danger"></span>
                </div>
                <br />
                <div class="form-group">
                    <label asp-for="Contact" class="control-label"></label>
                    <input asp-for="Contact" class="form-control" />
                    <span asp-validation-for="Contact" class="text-danger"></span>
                </div>
                <br />
                <div class="form-group">
                    <label asp-for="Qualifications" class="control-label"></label>
                    <input asp-for="Qualifications" class="form-control" />
                    <span asp-validation-for="Qualifications" class="text-danger"></span>
                </div>
                <br />
                <div class="form-group">
                    <label asp-for="CategoryOfpremises" class="control-label"></label>
                    <select asp-for="CategoryOfpremises" class="form-control" asp-items="ViewBag.Category"></select>
                    <span asp-validation-for="CategoryOfpremises" class="text-danger"></span>
                </div>
                <br />


                <div class="form-group">
                    <label asp-for="LicenseStatus" class="control-label"></label>
                    <select asp-for="LicenseStatus" class="form-control" asp-items="ViewBag.LicenseStatus"></select>
                    <span asp-validation-for="LicenseStatus" class="text-danger"></span>
                </div>
                <br />
                <div id="licno" class="conditional-fields2">
                    <div class="form-group">
                        <label asp-for="LicenseNo" class="control-label">License No.</label>
                        <input asp-for="LicenseNo" class="form-control" />
                        <span asp-validation-for="LicenseNo" class="text-danger"></span>
                    </div>
                </div>
                <br />
                <div class="form-group">
                    <label asp-for="CategoryStatus" class="control-label"></label>
                    <select asp-for="CategoryStatus" class="form-control" asp-items="ViewBag.CategoryofDrugs"></select>
                    <span asp-validation-for="CategoryStatus" class="text-danger"></span>
                </div>
                <br />
                <div class="form-group">
                    <label asp-for="FacilityType" class="control-label"></label>
                    <select asp-for="FacilityType" class="form-control" asp-items="ViewBag.FacilityType"></select>
                    <span asp-validation-for="FacilityType" class="text-danger"></span>
                </div>
                <br />
                <div class="form-group">
                    <label asp-for="certStatus" class="control-label"></label>
                    <select asp-for="certStatus" class="form-control" asp-items="ViewBag.CertificationStatus"></select>
                    <span asp-validation-for="certStatus" class="text-danger"></span>
                </div>
                <br />
                <div class="form-group">
                    <label asp-for="RecommendedforGDP" class="control-label"></label>
                    <select asp-for="RecommendedforGDP" class="form-control" asp-items="ViewBag.GDPRecommendation"></select>
                    <span asp-validation-for="RecommendedforGDP" class="text-danger"></span>
                </div>
            </div>
            <br />
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<br />
<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            // Hide all conditional fields initially
            $('.conditional-fields').hide();
            $('.conditional-fields2').hide();

            function showConditionalFields() {
                var facilityStatusValue = $('#FacilityStatus').val();
                var licenseStatusValue = $('#LicenseStatus').val();

                if (facilityStatusValue === '1') {
                    $('#open-facilty').show();
                }

                if (licenseStatusValue === '1') {
                    $('#licno').show();
                }
            }

            // Call the function on page load to check initial selections
            showConditionalFields();

            $('#FacilityStatus').change(function () {
                var selectedValue = $(this).val();

                // Hide all conditional fields
                $('.conditional-fields').hide();

                // Show relevant fields based on the selected value
                if (selectedValue === '1') {
                    $('#open-facilty').show();
                }
            });
            $('#LicenseStatus').change(function () {
                var selectedValue2 = $(this).val();

                // Hide all conditional fields
                $('.conditional-fields2').hide();

                // Show relevant fields based on the selected value
                if (selectedValue2 === '1') {
                    $('#licno').show();
                }
            });
            $("#getCoordinates").click(function () {
                if (navigator.geolocation) {
                    navigator.geolocation.getCurrentPosition(showPosition);
                } else {
                    alert("Geolocation is not supported by this browser.");
                }
            });

            var showPosition = (position) => {
                $("#Latitude").val(position.coords.latitude);
                $("#Longitude").val(position.coords.longitude);
            }
        });
    </script>
}
