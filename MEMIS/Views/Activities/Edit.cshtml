@model MEMIS.Data.Activity

@{
    ViewData["Title"] = "Edit";
    //Layout = "~/Views/Shared/_PlanningLayout.cshtml";
    Layout = "~/Pages/Shared/_ContentNavbarLayout.cshtml";
}

<h1>Edit</h1>

<h4>Activity</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="intActivity" />
            <div class="form-group">
                <label asp-for="activityCode" class="control-label"></label><span class="text-danger">*</span>
                <input asp-for="activityCode" class="form-control" />
                <span asp-validation-for="activityCode" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="activityName" class="control-label"></label><span class="text-danger">*</span>
                <input asp-for="activityName" class="form-control" />
                <span asp-validation-for="activityName" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="budgetCode" class="control-label"></label><span class="text-danger">*</span>
                <input asp-for="budgetCode" class="form-control" maxlength="7" />
                <span asp-validation-for="budgetCode" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="unitCost" class="control-label"></label><span class="text-danger">*</span>
                <input asp-for="unitCost" class="form-control formatted-number" type="text" maxlength="12" />
                <span asp-validation-for="unitCost" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="intAction" class="control-label"></label><span class="text-danger">*</span>
                @* <select asp-for="intAction" class="form-control" asp-items="ViewBag.intAction"></select> *@
                @Html.DropDownList("intAction", ViewData["intAction"] as SelectList, "-- Select Action --", new { @class = "form-control" })
                <span asp-validation-for="intAction" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<br />
<div>
    <a asp-action="Index">Back to List</a>
</div>

