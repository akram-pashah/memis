@model IEnumerable<ApplicationUser>

@{
    ViewData["Title"] = "User Management";
    Layout = "~/Pages/Shared/_ContentNavbarLayout.cshtml";
}

<h2>User Management</h2>

<table class="table">
    <thead>
        <tr>
            <th>Username</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.UserName</td>
                <td>@user.Email</td>
                <td>
                    <a asp-controller="UserManagement" asp-action="Edit" asp-route-id="@user.Id" class="btn btn-primary">Edit</a>
                    <button class="btn btn-danger" onclick="confirmDelete('@user.Id')">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-controller="UserManagement" asp-action="Register" class="btn btn-success">Add User</a>

@section Scripts {
    <script>
        function confirmDelete(userId) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/UserManagement/Delete/' + userId,
                        type: 'POST',
                        success: function (response) {
                            if (response.success) {
                                Swal.fire(
                                    'Deleted!',
                                    'User has been deactivated.',
                                    'success'
                                ).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire(
                                    'Error!',
                                    'There was an error deactivating the user.',
                                    'error'
                                );
                            }
                        },
                        error: function () {
                            Swal.fire(
                                'Error!',
                                'There was an error deactivating the user.',
                                'error'
                            );
                        }
                    });
                }
            });
        }
    </script>
}
