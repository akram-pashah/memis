@model IEnumerable<ApplicationUser>

@{
    ViewData["Title"] = "User Management";
    Layout = "~/Pages/Shared/_ContentNavbarLayout.cshtml";
}

<h2>User Management</h2>

<table class="table">
    <thead>
        <tr>
            <th>Username</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.UserName</td>
                <td>@user.Email</td>
                <td>
                    <a asp-controller="UserManagement" asp-action="Edit" asp-route-id="@user.Id" class="btn btn-primary">Edit</a>
                    <button class="btn btn-danger" onclick="confirmUserDelete('@user.Id')">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-controller="UserManagement" asp-action="Register" class="btn btn-success">Add User</a>

@section Scripts {
    <script>
        function confirmUserDelete(userId){
          confirmDelete(userId, () => {
           $.ajax({
                        url: '/UserManagement/Delete/' + userId,
                        type: 'POST',
                        success: function (response) {
                          if (response.success) {
                                  showSuccessMessage('User has been deactivated.', () => {
                                      location.reload();
                                  });
                              } else {
                                  showErrorMessage('There was an error deactivating the user.');
                              }
                        },
                        error: function () {
                            showErrorMessage('There was an error deactivating the user.');
                        }
                    });
        });
        };
    </script>
}
