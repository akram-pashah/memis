@using MEMIS.Data.Risk;
@model cloudscribe.Pagination.Models.PagedResult<RiskRegister>

@{
  ViewData["Title"] = "Risk Evaluation Verification [Director]";
  //Layout = "~/Views/Shared/_RiskLayout.cshtml";
  Layout = "~/Pages/Shared/_ContentNavbarLayout.cshtml";
}
<style>
    .content {
        width: calc(100% - 280px);
    }

    table {
        font-size: 12px;
    }

    .accordion-toggle:hover {
        background-color: #f0f0f0;
        cursor: pointer;
    }
</style>


<div class="row">
    <div class="col">
        <h3>
            Risk Evaluation Verification [Director]
        </h3>
    </div>
</div>

<div class="card">
  <div class="card-body">
        <div style="width:100%; overflow-x:auto;">
            <form asp-action="BulkRiskResidualDirVerify" method="post">
            <table id="RiskTable" class="table table-striped table-bordered table-hover dt-responsive nowrap">
                <thead class="table-active">
                    <tr>
                            <th><input type="checkbox" onclick="toggleAll(this)" /></th>
                            <th hidden>
                                @Html.DisplayNameFor(model => model.Data[0].RiskRefID)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Data[0].IdentifiedDate)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Data[0].RiskDescription)
                            </th>
                            <th>Treatment Plans</th>
                            <th>
                                @Html.DisplayNameFor(model => model.Data[0].RiskOwner)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Data[0].RiskConsequenceId)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Data[0].RiskLikelihoodId)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Data[0].riskTolerence)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Data[0].riskTolerenceJustification)
                            </th>
                            <th>Actions</th>
                    </tr>
                </thead>
                    <tbody>
                        @foreach (var item in Model.Data)
                        {
                            var collapseId = $"collapse_{item.RiskRefID}";

                            <tr>
                                <td>
                                    <input type="checkbox" class="VerifyCheckbox" name="selectedRiskIds" value="@item.RiskRefID" />
                                </td>
                                <td hidden>@item.RiskRefID</td>
                                <td>@item.IdentifiedDate.ToString("yyyy-MM-dd")</td>
                                <td>@item.RiskDescription</td>
                                <td class="accordion-toggle" data-bs-toggle="collapse" data-bs-target="#@collapseId">
                                    <i class="bx bx-chevron-down text-primary"></i>
                                    <span class="text-muted">Expand</span>
                                </td>
                                <td>
                                    @{
                                        string userName = !string.IsNullOrEmpty(item.RiskOwner) ? ViewBag.Users.FindByIdAsync(item.RiskOwner).Result.UserName : "";
                                    }
                                    @userName
                                </td>
                                <td>@Enum.GetName(typeof(RiskConsequence), item.RiskConsequenceId)</td>
                                <td>@Enum.GetName(typeof(RiskLikelihood), item.RiskLikelihoodId)</td>
                                <td>@item.riskTolerence</td>
                                <td>@item.riskTolerenceJustification</td>
                                <td>
                                    <div class="btn-group" role="group" aria-label="Actions">
                                        <a asp-action="Details" asp-route-id="@item.RiskRefID" class="btn btn-info" data-toggle="tooltip" data-placement="top" title="Details">
                                            <i class='bx bx-detail'></i>
                                        </a>
                                        <a asp-action="RiskResidualDirVerify" asp-route-id="@item.RiskRefID" class="btn btn-warning" data-toggle="tooltip" data-placement="top" title="Verify">
                                            <i class='bx bx-check'></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>

                            <!-- Treatment Actions Row -->
                            <tr class="collapse bg-light" id="@collapseId">
                                <td colspan="11" class="p-0">
                                    @if (item.RiskTreatmentPlans != null && item.RiskTreatmentPlans.Any())
                                    {
                                        <div class="p-2">
                                            <table class="table table-sm table-bordered mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Treatment Action</th>
                                                        <th>Indicator Description</th>
                                                        <th>Baseline</th>
                                                        <th>Cumulative Target</th>
                                                        <th>Frequency of Reporting</th>
                                                        <th>Frequency of Occurrence</th>
                                                        <th>Sample Size</th>
                                                        <th>Data Collection Method</th>
                                                        <th>Means of Verification</th>
                                                        <th>Responsible Persons</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var plan in item.RiskTreatmentPlans)
                                                    {
                                                        <tr>
                                                            <td>@plan.TreatmentAction</td>
                                                            <td>@plan.IndicatorDescription</td>
                                                            <td>@plan.Baseline</td>
                                                            <td>@plan.CumulativeTarget</td>
                                                            <td>@plan.FrequencyOfReporting</td>
                                                            <td>@plan.FrequencyOfOccurrence</td>
                                                            <td>@plan.SampleSize</td>
                                                            <td>@plan.DataCollectionInstrumentMethods</td>
                                                            <td>@plan.MeansOfVerification</td>
                                                            <td>@plan.ResponsiblePersons</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="p-2 text-muted">No treatment plans available.</div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
            </table>

                <div class="mt-3">
                    <button type="submit" name="action" value="approve" class="btn btn-success">Approve Selected</button>
                    <button type="submit" name="action" value="reject" class="btn btn-danger">Reject Selected</button>
                </div>
            </form>
            <cs-pager cs-paging-pagenumber="@Model.PageNumber"
                      cs-paging-totalitems="@Model.TotalItems"
                      cs-paging-pagesize="@Model.PageSize"
                      cs-pagenumber-param="pagenumber"
                      asp-controller="RiskIdentifications"
                      asp-action="Index"
                      cs-pager-li-current-class="page-item active"
                      cs-pager-li-other-class="page-item"
                      cs-pager-li-non-active-class="page-item disabled"
                      cs-pager-link-current-class="page-link"
                      cs-pager-link-other-class="page-link"></cs-pager>
        </div>
    </div>
</div>

@section Scripts {

    <script>

        $('#VerifyRiskButton').click(function () {
            GetSelected(true);
            sleep(1000);
            window.location.reload();
        });
        $('#UnVerifyRiskButton').click(function () {
            GetSelected(false);
            sleep(1000);
            window.location.reload();
        });
        function GetSelected(Isverified) {
           
            var grid = document.getElementById("RiskTable");
            var checkBoxes = grid.getElementsByClassName("VerifyCheckbox");
            for (var i = 0; i < checkBoxes.length; i++) {
                if (checkBoxes[i].checked) {
                    var row = checkBoxes[i].parentNode.parentNode;
                    $.ajax({
                        url: '/RiskIdentifications/VerifyRisk',
                        type: 'GET',
                        data: { id: row.cells[1].innerText, IsVerified: Isverified },
                        dataType: 'json',
                        success: function (data) {
                        },
                        error: function (error) {
                        }
                    });
                }
            }
            
        }
        function sleep(milliseconds) {
            const date = Date.now();
            let currentDate = null;
            do {
                currentDate = Date.now();
            } while (currentDate - date < milliseconds);
        }



    </script>
    @*@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}*@
}
