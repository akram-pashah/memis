@using Newtonsoft.Json
@model MEMIS.Models.EditActivityAssessmentDto

@{
    ViewData["Title"] = "Edit Activity Assessment";
    Layout = "~/Pages/Shared/_ContentNavbarLayout.cshtml";

    var quarterPlansJson = JsonConvert.SerializeObject(Model.QuaterlyPlans, new JsonSerializerSettings
    {
        ReferenceLoopHandling = ReferenceLoopHandling.Ignore
    });
}

<h4 class="mb-3 text-primary fw-bold">Edit Activity Assessment</h4>
<hr />

<div class="container-fluid">
    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="intDeptPlan" />
        <input type="hidden" name="QuaterlyPlans[0].Quarter" id="Quarter" />
        <input type="hidden" name="QuaterlyPlans[0].Id" id="Id" />
        <input type="hidden" name="QuaterlyPlans[0].ActivityAssessmentId" value="@Model.intDeptPlan" />

        <!-- General Info -->
        <fieldset class="border p-3 mb-4">
            <legend class="float-none w-auto px-2 text-info fw-bold">General Details</legend>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="strategicObjective" class="form-label">Strategic Objective</label>
                    <input asp-for="strategicObjective" class="form-control" disabled />
                </div>
                <div class="col-md-6">
                    <label asp-for="strategicIntervention" class="form-label">Strategic Intervention</label>
                    <input asp-for="strategicIntervention" class="form-control" disabled />
                </div>
                <div class="col-md-6">
                    <label asp-for="StrategicAction" class="form-label">Strategic Action</label>
                    <input asp-for="StrategicAction" class="form-control" disabled />
                </div>
                <div class="col-md-6">
                    <label asp-for="activity" class="form-label">Activity</label>
                    <input asp-for="activity" class="form-control" disabled />
                </div>
                <div class="col-md-6">
                    <label asp-for="outputIndicator" class="form-label">Output Indicator</label>
                    <input asp-for="outputIndicator" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="baseline" class="form-label">Baseline</label>
                    <input asp-for="baseline" class="form-control formatted-number" />
                </div>
                <div class="col-md-6">
                    <label asp-for="budgetCode" class="form-label">Budget Code</label>
                    <input asp-for="budgetCode" class="form-control formatted-number" />
                </div>
                <div class="col-md-6">
                    <label asp-for="comparativeTarget" class="form-label">Comparative Target</label>
                    <input asp-for="comparativeTarget" class="form-control formatted-number" />
                </div>
                <div class="col-md-6">
                    <label asp-for="unitCost" class="form-label">Unit Cost</label>
                    <input asp-for="unitCost" class="form-control formatted-number" onchange="SetBudgetValue()" />
                </div>
                <div class="col-md-6">
                    <label asp-for="budgetAmount" class="form-label">Budget Amount</label>
                    <input asp-for="budgetAmount" class="form-control formatted-number" />
                </div>
                <div class="col-md-12">
                    <label asp-for="justification" class="form-label">Justification</label>
                    <textarea asp-for="justification" class="form-control" rows="2"></textarea>
                </div>
            </div>
        </fieldset>

        <!-- Quarterly Assessment -->
        <!-- Quarterly Assessment -->
        <fieldset class="border p-3 mb-4">
            <legend class="float-none w-auto px-2 text-success fw-bold">Quarterly Assessment</legend>
            <div class="row g-3">
                <input type="hidden" asp-for="intDeptPlan" />
                <input type="hidden" name="QuaterlyPlans[0].Quarter" id="Quarter" />
                <input type="hidden" name="QuaterlyPlans[0].Id" id="Id" />
                <input type="hidden" name="QuaterlyPlans[0].ActivityAssessmentId" value="@Model.intDeptPlan" />

                <div class="col-md-4">
                    <label class="form-label">Quarter</label>
                    <select id="quarterSelector" class="form-select">
                        <option value="">-- Select Quarter --</option>
                        @foreach (SelectListItem item in ViewBag.Quarter)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Target</label>
                    <input name="QuaterlyPlans[0].QTarget" id="QTarget" class="form-control formatted-number" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Budget</label>
                    <input name="QuaterlyPlans[0].QBudget" id="QBudget" class="form-control formatted-number" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Actual</label>
                    <input name="QuaterlyPlans[0].QActual" id="QActual" class="form-control formatted-number" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Amount Spent</label>
                    <input name="QuaterlyPlans[0].QAmtSpent" id="QAmtSpent" class="form-control formatted-number" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Achievement</label>
                    <input name="QuaterlyPlans[0].QAchievement" id="QAchievement" class="form-control" />
                </div>
                <div class="col-md-12">
                    <label class="form-label">Justification</label>
                    <textarea name="QuaterlyPlans[0].QJustification" id="QJustification" class="form-control" rows="2"></textarea>
                </div>
            </div>
        </fieldset>


        <!-- Annual Summary -->
        <fieldset class="border p-3 mb-4">
            <legend class="float-none w-auto px-2 text-secondary fw-bold">Annual Summary</legend>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="TotAmtSpent" class="form-label">Total Amount Spent</label>
                    <input asp-for="TotAmtSpent" class="form-control formatted-number" />
                </div>
                <div class="col-md-4">
                    <label asp-for="ImpStatusId" class="form-label">Implementation Status</label>
                    <select asp-for="ImpStatusId" class="form-select" asp-items="ViewBag.ImpStatusId"></select>
                </div>
                <div class="col-md-12">
                    <label asp-for="AnnualJustification" class="form-label">Annual Justification</label>
                    <textarea asp-for="AnnualJustification" class="form-control" rows="2"></textarea>
                </div>
            </div>
        </fieldset>

        <!-- Submit -->
        <div class="mt-3">
            <button type="submit" class="btn btn-primary">
                <i class="bx bx-save"></i> Save Changes
            </button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
        </div>
    </form>

    @if (Model.QuaterlyPlans?.Any() == true)
    {
        <h5 class="text-secondary mt-5 mb-3 fw-bold">Added Quarterly Plans</h5>
        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead class="table-light">
                    <tr>
                        <th>Quarter</th>
                        <th>Target</th>
                        <th>Budget</th>
                        <th>Actual</th>
                        <th>Amount Spent</th>
                        <th>Achievement</th>
                        <th>Justification</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var plan in Model.QuaterlyPlans.OrderBy(p => p.Quarter))
                    {
                        <tr>
                            <td>@plan.Quarter</td>
                            <td>@(plan.QTarget ?? 0)</td>
                            <td>@(plan.QBudget ?? 0)</td>
                            <td>@(plan.QActual ?? 0)</td>
                            <td>@(plan.QAmtSpent ?? 0)</td>
                            <td>@plan.QAchievement</td>
                            <td>@plan.QJustification</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const allQuarterPlans = @Html.Raw(quarterPlansJson);

        function SetBudgetValue() {
            const unitCost = parseFloat(document.getElementById("unitCost")?.value) || 0;
            const comparativeTarget = parseFloat(document.getElementById("comparativeTarget")?.value) || 0;
            const budgetField = document.getElementById("budgetAmount");
            if (budgetField) {
                budgetField.value = (unitCost * comparativeTarget).toFixed(2);
            }
        }

        $(document).ready(function () {
            $('#quarterSelector').on('change', function () {
                const selectedQuarter = $(this).val();
                $('#Quarter').val(selectedQuarter);

                const quarterData = allQuarterPlans.find(q => q.Quarter === selectedQuarter);

                if (quarterData !== undefined) {
                    $('#Id').val(quarterData.Id);
                    $('#QTarget').val(quarterData.QTarget ?? '');
                    $('#QBudget').val(quarterData.QBudget ?? '');
                    $('#QActual').val(quarterData.QActual ?? '');
                    $('#QAmtSpent').val(quarterData.QAmtSpent ?? '');
                    $('#QAchievement').val(quarterData.QAchievement ?? '');
                    $('#QJustification').val(quarterData.QJustification ?? '');
                } else {
                    // Clear values for new quarter
                    $('#Id').val('0');
                    $('#QTarget').val('');
                    $('#QBudget').val('');
                    $('#QActual').val('');
                    $('#QAmtSpent').val('');
                    $('#QAchievement').val('');
                    $('#QJustification').val('');
                }
            });

            // Optional: Auto-select next available quarter (comment if not needed)
            const existingQuarters = allQuarterPlans.map(p => p.Quarter);
            const allQuarters = ["1", "2", "3", "4"];
            const nextQuarter = allQuarters.find(q => !existingQuarters.includes(q)) || allQuarterPlans[0]?.Quarter;

            if (nextQuarter) {
                $('#quarterSelector').val(nextQuarter);
                $('#Quarter').val(nextQuarter); // Important for hidden input
            }
        });
    </script>
}
