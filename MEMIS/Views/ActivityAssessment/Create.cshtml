@model MEMIS.Data.ActivityAssessment

@{
    ViewData["Title"] = "Create Activity Assessment";
    Layout = "~/Pages/Shared/_ContentNavbarLayout.cshtml";
}

<h4 class="mb-3 text-primary fw-bold">Create Activity Assessment</h4>
<hr />

<div class="container-fluid">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="intDeptPlan" />

        <!-- General Info -->
        <fieldset class="border p-3 mb-4">
            <legend class="float-none w-auto px-2 text-info fw-bold">General Details</legend>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="strategicObjective" class="form-label">Strategic Objective</label>
                    @Html.DropDownList("StrategicObjective", new SelectList(ViewBag.StrategicObjective, "intObjective", "ObjectiveName"), new { @class = "form-select" })
                </div>
                <div class="col-md-6">
                    <label asp-for="strategicIntervention" class="form-label">Strategic Intervention</label>
                    @Html.DropDownList("strategicIntervention", new SelectList(ViewBag.StrategicIntervention, "intIntervention", "InterventionName"), new { @class = "form-select" })
                </div>
                <div class="col-md-6">
                    <label asp-for="StrategicAction" class="form-label">Strategic Action</label>
                    @Html.DropDownList("StrategicAction", new SelectList(ViewBag.StrategicAction, "intAction", "actionName"), new { @class = "form-select" })
                </div>
                <div class="col-md-6">
                    <label asp-for="activity" class="form-label">Activity</label>
                    @Html.DropDownList("Activity", new SelectList(ViewBag.Activity, "intActivity", "activityName"), new { @class = "form-select" })
                </div>
                <div class="col-md-6">
                    <label asp-for="outputIndicator" class="form-label">Output Indicator</label>
                    <input asp-for="outputIndicator" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="baseline" class="form-label">Baseline</label>
                    <input asp-for="baseline" class="form-control formatted-number" />
                </div>
                <div class="col-md-6">
                    <label asp-for="budgetCode" class="form-label">Budget Code</label>
                    <input asp-for="budgetCode" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="comparativeTarget" class="form-label">Comparative Target</label>
                    <input asp-for="comparativeTarget" class="form-control formatted-number" />
                </div>
                <div class="col-md-6">
                    <label asp-for="unitCost" class="form-label">Unit Cost</label>
                    <input asp-for="unitCost" class="form-control formatted-number" onchange="SetBudgetValue()" />
                </div>
                <div class="col-md-6">
                    <label asp-for="budgetAmount" class="form-label">Budget Amount</label>
                    <input asp-for="budgetAmount" class="form-control formatted-number" />
                </div>
                <div class="col-md-12">
                    <label asp-for="justification" class="form-label">Justification</label>
                    <textarea asp-for="justification" class="form-control" rows="2"></textarea>
                </div>
            </div>
        </fieldset>

        <!-- Quarterly Assessment -->
        <fieldset class="border p-3 mb-4">
            <legend class="float-none w-auto px-2 text-success fw-bold">Quarterly Assessment</legend>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Quarter</label>
                    <select asp-for="QuaterlyPlans[0].Quarter" class="form-select" asp-items="ViewBag.Quarter"></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="QuaterlyPlans[0].QTarget" class="form-label">Target</label>
                    <input asp-for="QuaterlyPlans[0].QTarget" class="form-control formatted-number" />
                </div>
                <div class="col-md-4">
                    <label asp-for="QuaterlyPlans[0].QBudget" class="form-label">Budget</label>
                    <input asp-for="QuaterlyPlans[0].QBudget" class="form-control formatted-number" />
                </div>
                <div class="col-md-4">
                    <label asp-for="QuaterlyPlans[0].QActual" class="form-label">Actual</label>
                    <input asp-for="QuaterlyPlans[0].QActual" class="form-control formatted-number" />
                </div>
                <div class="col-md-4">
                    <label asp-for="QuaterlyPlans[0].QAmtSpent" class="form-label">Amount Spent</label>
                    <input asp-for="QuaterlyPlans[0].QAmtSpent" class="form-control formatted-number" />
                </div>
                <div class="col-md-4">
                    <label asp-for="QuaterlyPlans[0].QAchievement" class="form-label">Achievement</label>
                    <input asp-for="QuaterlyPlans[0].QAchievement" class="form-control" />
                </div>
                <div class="col-md-12">
                    <label asp-for="QuaterlyPlans[0].QJustification" class="form-label">Justification</label>
                    <textarea asp-for="QuaterlyPlans[0].QJustification" class="form-control" rows="2"></textarea>
                </div>
            </div>
        </fieldset>

        <!-- Annual Summary -->
        <fieldset class="border p-3 mb-4">
            <legend class="float-none w-auto px-2 text-secondary fw-bold">Annual Summary</legend>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="AnnualAchievement" class="form-label">Annual Achievement</label>
                    <input asp-for="AnnualAchievement" class="form-control formatted-number" />
                </div>
                <div class="col-md-4">
                    <label asp-for="TotAmtSpent" class="form-label">Total Amount Spent</label>
                    <input asp-for="TotAmtSpent" class="form-control formatted-number" />
                </div>
                <div class="col-md-4">
                    <label asp-for="ImpStatusId" class="form-label">Implementation Status</label>
                    <select asp-for="ImpStatusId" class="form-select" asp-items="ViewBag.ImpStatusId"></select>
                </div>
                <div class="col-md-12">
                    <label asp-for="AnnualJustification" class="form-label">Annual Justification</label>
                    <textarea asp-for="AnnualJustification" class="form-control" rows="2"></textarea>
                </div>
            </div>
        </fieldset>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">
                <i class="bx bx-save"></i> Save Activity Assessment
            </button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function SetBudgetValue() {
            let unitCost = parseFloat(document.getElementById("unitCost").value) || 0;
            let comparativeTarget = parseFloat(document.getElementById("comparativeTarget")?.value) || 0;
            let budgetField = document.getElementById("budgetAmount");
            if (budgetField) {
                budgetField.value = (unitCost * comparativeTarget).toFixed(2);
            }
        }
    </script>
}
